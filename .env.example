# THAY Funnel Builder — variáveis de ambiente do Cloudflare Worker
# Copie este arquivo, renomeie para .env e preencha os valores.
# NUNCA commite o .env com valores reais.

# Chave da API Anthropic — obtida em console.anthropic.com
# Fica SOMENTE no servidor. Nunca no frontend.
CLAUDE_API_KEY=

# Modelo Claude a usar (padrão: claude-opus-4-7)
ANTHROPIC_MODEL=claude-opus-4-7

# Modo mock para desenvolvimento local (true | false)
# true  → retorna copy de exemplo sem chamar Claude
# false → chama Claude de verdade (requer CLAUDE_API_KEY)
USE_MOCK_AI=false

# Domínio permitido para CORS (ex: https://app.thay.com.br)
# Use * apenas em desenvolvimento
ALLOWED_ORIGIN=*
